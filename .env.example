SECRET_KEY=replace-with-a-long-random-value
APP_BASE_URL=http://127.0.0.1:5000
APP_TIMEZONE=Asia/Ho_Chi_Minh
EMAIL_VERIFICATION_REQUIRED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Render: ưu tiên Resend vì dịch vụ miễn phí chặn cổng SMTP.
RESEND_API_KEY=
EMAIL_FROM=Budget Buddy <notifications@your-verified-domain.com>
# SMTP fallback cho máy chủ cho phép SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
# DATABASE_URL=sqlite:///instance/app.db
